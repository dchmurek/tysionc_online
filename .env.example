# Przykładowa konfiguracja – skopiuj do .env i dostosuj. Plik .env NIE trafia do repozytorium.
NODE_ENV=production
# Serwer nasłuchuje lokalnie; HTTPS i WebSocket z internetu obsługuje nginx/Caddy (odwrotne proxy).
HOST=127.0.0.1
PORT=8080
# Katalog danych JSON – POZA katalogiem publicznym, z prawami tylko dla użytkownika usługi.
DATA_DIR=/var/lib/tysiac
# Za proxy z HTTPS:
TRUST_PROXY=1
COOKIE_SECURE=1
# Adres strony (dla kontroli Origin WebSocket/POST), np. https://tysiac.example.pl
ALLOWED_ORIGINS=
# Limit rejestracji z jednego IP na godzinę
REGISTER_PER_HOUR=20
# Ile kopii dziennych trzymać
BACKUP_KEEP=60
LOG_LEVEL=info
